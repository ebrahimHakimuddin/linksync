{
  "manifest_version": 3,
  "name": "CrossLinks",
  "description": "Open links sent from your Android device in Chrome, and save articles at the exact spot you stopped reading.",
  "version": "0.3.0",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "alarms", "contextMenus", "favicon", "notifications", "scripting", "storage", "tabs"],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CrossLinks",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "options.html",
  "commands": {
    "save-position": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save this page at your current reading position"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
